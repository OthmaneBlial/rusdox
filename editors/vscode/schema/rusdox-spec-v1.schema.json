          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "Optional line size in eighths of a point.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
