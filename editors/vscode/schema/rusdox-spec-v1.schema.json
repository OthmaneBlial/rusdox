  "$id": "https://othmaneblial.github.io/rusdox/schema/rusdox-spec-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema for YAML, JSON, and TOML RusDox authoring. Files are local-first and deterministic.",
  "properties": {
    "blocks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BlockSpec"
      },
      "type": "array"
    },
    "footer": {
      "anyOf": [
        {
          "$ref": "#/$defs/HeaderFooter"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional default footer template."
    },
    "header": {
      "anyOf": [
        {
          "$ref": "#/$defs/HeaderFooter"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional default header template."
    },
    "metadata": {
      "$ref": "#/$defs/DocumentMetadata",
      "default": {
        "author": null,
        "custom_properties": {},
        "keywords": [],
        "subject": null,
        "title": null
      },
      "description": "Optional core and custom document metadata written into the DOCX package."
    },
    "output_name": {
      "default": null,
      "description": "Optional logical output name. Falls back to the spec file stem when absent.",
      "type": [
        "string",
        "null"
      ]
    },
    "page_numbering": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageNumbering"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional page numbering format and restart control."
    },
    "page_setup": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageSetup"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional page size and margin overrides for the document section."
    },
    "styles": {
      "$ref": "#/$defs/Stylesheet",
      "default": {
        "paragraph": [],
        "run": [],
        "table": []
      },
      "description": "Reusable named styles available to blocks and runs in this document."
    },
    "variables": {
      "additionalProperties": true,
      "default": {},
      "description": "Local values available to deterministic {{ path | filter }} expressions, repeat blocks, and when blocks.",
      "type": "object"
    },
    "version": {
      "const": 1,
      "default": 1,
      "description": "Version of the declarative document-spec contract.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "blocks"
  ],
  "title": "RusDox document specification",
  "type": "object",
  "x-rusdox-authoring-formats": [
    "yaml",
    "json",
    "toml"
  ],
  "x-rusdox-spec-version": 1
}
